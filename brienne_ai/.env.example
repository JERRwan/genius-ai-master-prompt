# BRIENNE AI local configuration
# Copy this file to .env and adjust values for your computer.
# Do not commit .env or place secrets in this file.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

BRIENNE_DB_PATH=data/brienne.db
BRIENNE_LOG_DIR=data/logs

BRIENNE_MEMORY_ENABLED=true
BRIENNE_VOICE_ENABLED=true
BRIENNE_TTS_ENABLED=true
BRIENNE_AUTOMATION_ENABLED=true
BRIENNE_REQUIRE_CONFIRMATION=true
BRIENNE_WAKE_WORD_ENABLED=false

# Optional UI and monitoring settings
BRIENNE_THEME=dark
BRIENNE_SYSTEM_REFRESH_SECONDS=2
BRIENNE_LOG_LEVEL=INFO

# Optional local speech-recognition settings, if implemented by the project
# BRIENNE_SPEECH_MODE=offline
# BRIENNE_VOSK_MODEL_PATH=

# Optional online features. Leave disabled unless the user explicitly enables
# them and the implementation documents the service and data flow.
# BRIENNE_ONLINE_FEATURES_ENABLED=false
